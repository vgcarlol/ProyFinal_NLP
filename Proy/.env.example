# Copiar a Proy/.env y ajustar si hace falta. No contiene credenciales: todo corre local.
OLLAMA_URL=http://localhost:11434
LLM_MODEL=qwen2.5:7b-instruct
LLM_TEMPERATURE=0.0
LLM_TIMEOUT_S=120

# Recuperación
TOP_K=5
BM25_MIN_SCORE=4.0

# Chunking
CHUNK_MAX_WORDS=300
CHUNK_OVERLAP_WORDS=40

# OCR (Tesseract). Por defecto usa Proy/tessdata/spa.traineddata
# TESSDATA_DIR=/ruta/a/tessdata
OCR_DPI=250
OCR_LANG=spa

# Fase 3: recuperación híbrida y agente
EMBED_MODEL=intfloat/multilingual-e5-base
RERANK_MODEL=BAAI/bge-reranker-v2-m3
DEVICE=mps                 # "cpu" si no hay Apple Silicon / CUDA
RERANK_MIN_SCORE=0.02      # umbral de abstención (calibrado)
LOW_CONFIDENCE_SCORE=0.30  # bajo esto la respuesta pide revisión humana
LLM_MAX_TOKENS=400
JUDGE_MODEL=qwen2.5:7b-instruct
# TODAY=2026-11-19         # fecha de referencia para vigencia (benchmark la fija)
